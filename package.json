{
  "name": "crm-stroy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint:fsd": "steiger ./src",
    "verify": "pnpm check && pnpm lint:fsd && pnpm typecheck"
  },
  "dependencies": {
    "@farfetched/core": "^0.15.0",
    "@supabase/supabase-js": "^2.119.0",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "steiger": "^0.9.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
